# ─────────────────────────────────────────────────────────────────────────────
# app/.env.example — Aphotic front-end
#
# Copy to app/.env.local (gitignored) and fill the blanks.
# This file and app/src/config.ts are the ONLY places in app/ where a canonical
# on-chain id may appear (G7). Never put a secret here — no private keys, no
# OAuth client SECRET (the zkLogin *client id* is public and is fine).
#
# ⚠⚠ EVERY `VITE_*` BELOW IS INLINED AT BUILD TIME. A var missing from the CI
# environment does not fail at runtime — it compiles to "". The app therefore
# validates loudly at startup (src/config.ts `configProblems()`), but the real
# fix is to set these BEFORE `vite build`.
#
# Values marked [RECON Rn] were verified live on Sui testnet — do NOT re-derive.
# Values marked [v2] are UNKNOWN until the v2 Move package is published.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network / transport ──────────────────────────────────────────────────────
VITE_SUI_NETWORK=testnet

# gRPC is the DEFAULT read transport. The testnet fullnode serves gRPC v2 only —
# its JSON-RPC endpoint returns 404 (removed).                        [RECON R1]
VITE_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# @mysten/dapp-kit 1.1.9's SuiClientProvider is typed to SuiJsonRpcClient and
# CANNOT take a gRPC client, so wallet/dapp-kit reads use a JSON-RPC mirror.
# Alternates: https://sui-testnet-rpc.publicnode.com
#             https://sui-testnet.nodeinfra.com
VITE_SUI_JSONRPC_URL=https://rpc-testnet.suiscan.xyz:443

# ── Aphotic (our own package + its shared objects) ───────────────────────────
# Type arguments resolve against the ORIGINAL id forever; moveCall targets the
# CURRENT published-at id. They diverge the moment we upgrade — keep both.
# PUBLISHED 2026-07-26 · digest Hyso18276VRqbDyt9DbvFBDvActna7mbUWutedzUgm7o
# Fresh publish, so the two are equal today and diverge on the first upgrade.
VITE_APHOTIC_PACKAGE_ID=0xfa214c431cee927137422f042ed679eb6180c226d30fa3e98c6bea9e09597df2
VITE_APHOTIC_ORIGINAL_PACKAGE_ID=0xfa214c431cee927137422f042ed679eb6180c226d30fa3e98c6bea9e09597df2

# ⚠ CORRECTION (2026-07-26, read before wiring these up).
# There are only THREE shared objects in the v2 design, not seven. Reading the Move
# source rather than this list: `NoteTree`, `NullifierSet`, `DenomLadder`, the
# `CapRegistry` and BOTH `BalanceBook`s are embedded in `Vault` BY VALUE
# (`move/sources/vault.move` — `tree:` `nulls:` `ladder:` `caps:` `base_book:`
# `quote_book:`). They are struct fields, so they have NO object id of their own and
# never will. The four vars below them therefore all take the VAULT id, and are read
# as fields of the vault, not fetched as objects.
#
# Shared #1 — Vault: shares, NAV propose/approve lifecycle, fees, AND the note tree,
# nullifier set, cap registry and both balance books.
VITE_VAULT_ID=0x91660fb483ec6c8ee4f9c2b4be04872b5808955fdcda962b5be5905989b3efcf
# Shared #2 — BatchRegistry (`batch::create_registry` + `share_registry`).
VITE_BATCH_REGISTRY_ID=0x9967881e88d5e22fc790d3b761e8ca55c8fd87d1a07baa11eb4a4352cd356b35
# Shared #3 — AdapterRegistry, the pinned lending-adapter allowlist
# (`allocate::create`). The ONLY runtime object that does not need a vault id first,
# which is why it is the only one that exists.
# LIVE · digest CqeesXgjs8sFtKxTfjYSQb5ao1ePLGtDLVNTMfqahNGu · isv 953314528
VITE_ADAPTER_ALLOWLIST_ID=0xd743861834773a8129301e766be83ba43c0fe4227aef6181c11a222618a0b9f1
#
# ── the four below are NOT separate objects: each takes the VAULT id ─────────
# Kept as distinct vars so app code reads by intent, but do not go looking for an
# object to fetch — `configProblems()` treats a blank as its own failure.
# Governance = the `CapRegistry` embedded in the vault (caps, pause, governed params).
VITE_GOVERNANCE_ID=0x91660fb483ec6c8ee4f9c2b4be04872b5808955fdcda962b5be5905989b3efcf
# The append-only commitment tree (depth 20), field `tree` of the vault.
VITE_NOTE_TREE_ID=0x91660fb483ec6c8ee4f9c2b4be04872b5808955fdcda962b5be5905989b3efcf
# Single-use spend tags, field `nulls` of the vault.
VITE_NULLIFIER_SET_ID=0x91660fb483ec6c8ee4f9c2b4be04872b5808955fdcda962b5be5905989b3efcf
# Escrow custody — the `base_book`/`quote_book` fields. Deliberately OUTSIDE vault NAV
# so a settlement cannot move assets between propose_nav and approve_nav (D7).
VITE_BALANCE_LEDGER_ID=0x91660fb483ec6c8ee4f9c2b4be04872b5808955fdcda962b5be5905989b3efcf
#
# The package and the AdapterRegistry are LIVE. VAULT / BATCH_REGISTRY and the four
# vault-derived vars are still blank, blocked by B26: `vault::create<B,Q,S>` consumes a
# `TreasuryCap<S>` and the package defines no LP share coin, so no `Vault` can be created
# and `batch::create_registry(vault_id, ctx)` cannot be called either.
# ⚠ VITE_* is inlined at BUILD time — a blank here is a broken deploy, not a runtime error.
# See docs/DEPLOYED.md § "APHOTIC v2 — PUBLISHED".

# ── Hashi (testnet) ──────────────────────────────────────────────────────────
VITE_HASHI_PACKAGE_ID=0xfcea10cadbb553c4874201584abf68771592678952efd957b2e82c010c7f4360
VITE_HASHI_OBJECT_ID=0x22c0ce66ce09df2dc88a31bd320d4177b766518b9b88010368cfbdcd724528f8
VITE_HBTC_TYPE=0xfcea10cadbb553c4874201584abf68771592678952efd957b2e82c010c7f4360::btc::BTC

# Live Hashi config, read from the shared object.                     [RECON R6]
# hashi::btc_config accessors are public(package) ⇒ NOT callable — inject them.
VITE_HASHI_WITHDRAWAL_MIN_SATS=30000
VITE_HASHI_DEPOSIT_MIN_SATS=30000
VITE_HASHI_CONFIRMATIONS=6
VITE_HASHI_CANCEL_COOLDOWN_MS=3600000

# ── DeepBook v3 (testnet) — carry entry + the NAV deviation reference ────────
VITE_DEEPBOOK_POOL=0x5cdaebf264f8b0db4233098cb4cca33d11e4d8c179d5fbd36a5bed361a55ced6
VITE_DBUSDC_TYPE=0xf7152c05930480cd740d7311b5b8b45c6f488e3a53a11c3f74a6fac36a52e0d7::DBUSDC::DBUSDC
# Type arguments resolve against the ORIGINAL id; moveCall targets the CURRENT
# CALLABLE id (v20).                                                  [RECON R4]
VITE_DEEPBOOK_PACKAGE=0xd874d2417a55bfa6479bffa06ad950fea144ef93a94cc6c49f32b03e386bbb24
VITE_DEEPBOOK_ORIGINAL_PACKAGE=0xfb28c4cbc6865bd1c897d26aecbe1f8792d1509a20ffec692c800660cbec6982

# ── Seal committee (time-lock policy over the sealed orders) ─────────────────
# D9: n = 5 servers across 5 DISTINCT OPERATORS, t = 3. Count operators, not
# servers — two servers run by one party are one failure domain.
#
# ⚠ Enoki must NOT appear here. It is our zkLogin salt provider; giving it a
#   decryption share too would hand one party identity linkage AND plaintext
#   (aphotic.md §7.5).
# ⚠ @mysten/seal makes `serverConfigs` REQUIRED and ships no default set, so
#   there is no accidental committee. If these are empty, orders are not
#   encrypted — and we NEVER fall back to plaintext; we refuse to open a batch.
# Health-probe /v1/service: it needs BOTH a `Client-Sdk-Version` header and a
# `?service_id=` query param, or it answers 400.
VITE_SEAL_KEY_SERVER_IDS=                                                 # [v2]
VITE_SEAL_KEY_SERVER_URLS=                                                # [v2]
VITE_SEAL_THRESHOLD=3
# Bumped to invalidate every outstanding Seal identity at once.
VITE_SEAL_POLICY_VERSION=1

# ── Walrus (order ciphertext blobs) ─────────────────────────────────────────
VITE_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# Backup aggregators if the primary rate-limits:
#   https://wal-aggregator-testnet.staketab.org
#   https://walrus-testnet-aggregator.nodes.guru
VITE_WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space

# ── zkLogin via Enoki ────────────────────────────────────────────────────────
# Both values are PUBLIC and safe in the bundle. Setup, once:
#   1. https://portal.enoki.mystenlabs.com → create an app → copy the PUBLIC api
#      key (starts `enoki_public_`). NEVER ship the `enoki_private_` one.
#   2. Google Cloud console → OAuth 2.0 Client ID, type "Web application".
#      Authorised JavaScript origin + redirect URI must BOTH list the app origin
#      (http://localhost:5173 in dev). Copy the client id — never the secret.
#   3. Register that client id under the Enoki app's Google provider and
#      allow-list the origin there too.
VITE_ENOKI_API_KEY=
VITE_ZKLOGIN_CLIENT_ID=
# Empty ⇒ Enoki defaults to window.location.origin.
VITE_ENOKI_REDIRECT_URL=

# ── Custody boundary (aphotic.md §6.3) ──────────────────────────────────────
# The carry exit needs a real transaction SIGNER, because Hashi's
# create_withdrawal sets `sender: ctx.sender()` and a shared object can never be
# the sender. So the exit runs through a Sui 2-of-2 multisig (keeper + an
# independent policy co-signer) and the BTC lands at an address no Move code
# controls. Pinning is enforced AT SIGNING, not by Move. Publishing the address
# is what makes redemptions auditable on Bitcoin — say so plainly.
VITE_CUSTODY_MULTISIG=                                                    # [v2]
VITE_REDEMPTION_ADDRESS=                                                  # [v2]

# ── Explorers ────────────────────────────────────────────────────────────────
VITE_SUI_EXPLORER=https://suiscan.xyz/testnet
VITE_BITCOIN_EXPLORER=https://mempool.space/signet
