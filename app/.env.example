# ─────────────────────────────────────────────────────────────────────────────
# app/.env.example — Aphotic × Hashi frontend
#
# Copy to app/.env.local (gitignored) and fill the day-one blanks.
# This file and app/src/config.ts are the ONLY places in app/ where a canonical
# on-chain id may appear (G7). Never put a secret here — no private keys, no
# OAuth client SECRET (the zkLogin *client id* is public and is fine).
#
# Values marked [RECON Rn] were verified live on 2026-07-25 — do NOT re-derive.
# Values marked [DAY-ONE] are UNKNOWN until docs/DAY-ONE.md is executed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network / transport ──────────────────────────────────────────────────────
VITE_SUI_NETWORK=testnet

# gRPC is the DEFAULT read transport. The testnet fullnode serves gRPC v2 only —
# its JSON-RPC endpoint returns 404 (removed).                        [RECON R1]
VITE_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# @mysten/dapp-kit 1.1.9's SuiClientProvider is typed to SuiJsonRpcClient and
# CANNOT take a gRPC client, so wallet/dapp-kit reads must use a JSON-RPC mirror.
# Verified live, chain id 4c78adac.                                   [RECON R1]
# Alternates: https://sui-testnet-rpc.publicnode.com
#             https://sui-testnet.nodeinfra.com
VITE_SUI_JSONRPC_URL=https://rpc-testnet.suiscan.xyz:443

# mock = deterministic fixtures, zero signet/RPC (docs/APP.md §5, G6/G7)
# live = real adapters (BTC-latency stages are STILL pre-staged — G6)
VITE_DEMO_MODE=mock

# ── Aphotic (our own package) ────────────────────────────────────────────────
# Published on testnet 2026-07-25, upgraded to v2. Full record: docs/DEPLOYED.md
# TARGET = the current published-at. ORIGINAL = the type origin, which the Vault's
# type string keeps forever — same two-id split as DeepBook (RECON R4).
VITE_APHOTIC_PACKAGE_ID=0xbf55eecc6c840c576c88e05c469f9753ab5ad9212e04c6cf56564f88929875bf
VITE_APHOTIC_ORIGINAL_PACKAGE_ID=0xbe433a2726fc61391d180ce55cdb8177f9647760b23a7704d42e3b5b9bb72d66
VITE_VAULT_ID=0xf03832c92d4bf745ac720c52fe9198fc928028ce51991059bfe59c0e4ef374e8

# ── Hashi (testnet) ──────────────────────────────────────────────────────────
VITE_HASHI_PACKAGE_ID=0xfcea10cadbb553c4874201584abf68771592678952efd957b2e82c010c7f4360
VITE_HASHI_OBJECT_ID=0x22c0ce66ce09df2dc88a31bd320d4177b766518b9b88010368cfbdcd724528f8
VITE_HBTC_TYPE=0xfcea10cadbb553c4874201584abf68771592678952efd957b2e82c010c7f4360::btc::BTC

# Live Hashi config, read from the shared object 2026-07-25.          [RECON R6]
# hashi::btc_config accessors are public(package) ⇒ NOT callable — inject them.
VITE_HASHI_WITHDRAWAL_MIN_SATS=30000
VITE_HASHI_DEPOSIT_MIN_SATS=30000
VITE_HASHI_DEPOSIT_DELAY_MS=600000
VITE_HASHI_CONFIRMATIONS=6
VITE_HASHI_CANCEL_COOLDOWN_MS=3600000

# ── DeepBook v3 (testnet) ────────────────────────────────────────────────────
VITE_DEEPBOOK_POOL=0x5cdaebf264f8b0db4233098cb4cca33d11e4d8c179d5fbd36a5bed361a55ced6
VITE_DBUSDC_TYPE=0xf7152c05930480cd740d7311b5b8b45c6f488e3a53a11c3f74a6fac36a52e0d7::DBUSDC::DBUSDC
# Type arguments resolve against the ORIGINAL id; moveCall targets the CURRENT
# CALLABLE id (v20). docs/FACTS.md records v17 and is STALE.          [RECON R4]
VITE_DEEPBOOK_PACKAGE=0xd874d2417a55bfa6479bffa06ad950fea144ef93a94cc6c49f32b03e386bbb24
VITE_DEEPBOOK_ORIGINAL_PACKAGE=0xfb28c4cbc6865bd1c897d26aecbe1f8792d1509a20ffec692c800660cbec6982

# ── Pyth (testnet REQUIRES the Beta channel — G9) ────────────────────────────
VITE_PYTH_STATE=0x243759059f4c3111179da5878c12f68d612c21a8d54d85edc86164bb18be1c7c
VITE_PYTH_PACKAGE=0xabf837e98c26087cba0883c0a7a28326b1fa3c5e1e2c5abdb486f9e8f594c837
VITE_PYTH_HERMES_URL=https://hermes-beta.pyth.network
VITE_PYTH_FEED_ID=0xf9c0172ba10dfa4d19088d94f5bf61d3b54d5bd7483a322a982e1373ee8ea31b
# NEVER set the stable/mainnet id 0xe62df6c8... on testnet (G9).      [RECON R11]

# ── Walrus (decision log + strategy ciphertext reads) ────────────────────────
# U7 RESOLVED by DAY-ONE D8: a real PUT -> GET round trip succeeded on testnet.
# Backups if the primary rate-limits:
#   https://wal-aggregator-testnet.staketab.org
#   https://walrus-testnet-aggregator.nodes.guru
VITE_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space

# ── zkLogin via Enoki + sponsored transactions ───────────────────────────────
# Onboarding is Enoki-backed zkLogin registered as a wallet-standard wallet
# (@mysten/enoki 1.2.7 `registerEnokiWallets`; every '@mysten/enoki/react' hook
# is deprecated upstream). Both values below are PUBLIC and safe in the bundle.
#
# Setup, once:
#   1. https://portal.enoki.mystenlabs.com → create an app → copy the PUBLIC api
#      key (starts `enoki_public_`). NEVER ship the `enoki_private_` one.
#   2. Google Cloud console → OAuth 2.0 Client ID, type "Web application".
#      Authorised JavaScript origin + redirect URI must BOTH list the app origin
#      (http://localhost:5173 in dev). Copy the client id — never the secret.
#   3. Register that same client id under the Enoki app's Google provider, and
#      allow-list the origin there too.
#   4. Enable a gas pool on the Enoki app to get sponsored (zero-SUI) first
#      deposits. Sponsorship changes who PAYS, never who the SENDER is.
VITE_ENOKI_API_KEY=                                               # [DAY-ONE]
VITE_ZKLOGIN_CLIENT_ID=                                           # [DAY-ONE]

# Empty ⇒ Enoki defaults to window.location.origin. Whatever is set here must be
# allow-listed in BOTH the Enoki portal and the Google console, or the popup
# fails with redirect_uri_mismatch.
VITE_ENOKI_REDIRECT_URL=

# Optional: a custom gas-sponsor endpoint. Leave empty to use Enoki's gas pool.
VITE_SPONSOR_URL=

# ── Keeper verify/ replay endpoint (Transparency bridge column, G5) ──────────
VITE_KEEPER_VERIFY_URL=http://localhost:8787

# ── Explorers ────────────────────────────────────────────────────────────────
VITE_SIGNET_EXPLORER=https://mempool.space/signet
VITE_SUI_EXPLORER=https://suiscan.xyz/testnet
