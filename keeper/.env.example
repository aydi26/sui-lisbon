# ┌── APHOTIC CONTRACT ────────────────────────────────────────────────────────
# @task       T0.3, T0.6
# @phase      0
# @status     DONE
# @spec       docs/KEEPER.md §12 (environment variables)
# @spec       docs/BUILD-PLAN.md#phase-0 (T0.6 config wiring proof)
# @spec       docs/RECON.md#r1 #r4 #r5 #r6 #r9 #r11 (every id verified LIVE 2026-07-25)
# @rules      G7 G9
# @facts      This file and keeper/src/config.ts are the ONLY places a canonical id may appear.
# @facts      Copy to `keeper/.env` (gitignored) and fill the SECRETS. NEVER put a key here.
# @implements the full env surface consumed by src/config.ts loadConfig()
# @forbidden  a private key, mnemonic or seed IN THIS FILE — .env.example is committed
# @verify     cd keeper && npm test -- config
# └── END CONTRACT ───────────────────────────────────────────────────────────

# ── Sui network / RPC transport (docs/RECON.md R1) ───────────────────────────
SUI_NETWORK=testnet
# grpc (default) | jsonRpc.  ⚠ fullnode.testnet.sui.io serves gRPC v2 ONLY — its JSON-RPC is 404.
SUI_TRANSPORT=grpc
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# JSON-RPC is opt-in for probes only; these three mirrors are verified (chain id 4c78adac).
SUI_JSON_RPC_URL=https://rpc-testnet.suiscan.xyz:443
SUI_JSON_RPC_MIRRORS=https://rpc-testnet.suiscan.xyz:443,https://sui-testnet-rpc.publicnode.com,https://sui-testnet.nodeinfra.com
# Keeper identity — holds the DeepBook TradeCap and NOTHING else (G2). Required in real mode.
SUI_KEEPER_ADDRESS=

# ── Adapter selection (G7) ───────────────────────────────────────────────────
# mock (default; deterministic, offline, used by every test and by CI) | real
HASHI_ADAPTER=mock

# ── SECRETS — set these ONLY in keeper/.env (gitignored). NEVER here. ─────────
# KEEPER_KEY signs trade PTBs and the permissionless confirm_deposit crank.
# SUI_PRIVATE_KEY is accepted as an alias for KEEPER_KEY.
KEEPER_KEY=
OWNER_KEY=

# ── Hashi (docs/RECON.md R5 + R6) ────────────────────────────────────────────
HASHI_PACKAGE_ID=0xfcea10cadbb553c4874201584abf68771592678952efd957b2e82c010c7f4360
HASHI_OBJECT_ID=0x22c0ce66ce09df2dc88a31bd320d4177b766518b9b88010368cfbdcd724528f8
HASHI_OBJECT_INITIAL_SHARED_VERSION=805474231
HBTC_COIN_TYPE=0xfcea10cadbb553c4874201584abf68771592678952efd957b2e82c010c7f4360::btc::BTC
HBTC_DECIMALS=8
# gRPC-only endpoint; plain HTTP returns 464.
HASHI_GUARDIAN_URL=https://guardian.testnet.hashi.sui.io
# Live on-chain config, read from the Hashi shared object 2026-07-25.
HASHI_DEPOSIT_TIME_DELAY_MS=600000
HASHI_DEPOSIT_MINIMUM_SATS=30000
HASHI_WITHDRAWAL_MINIMUM_SATS=30000
HASHI_CONFIRMATION_THRESHOLD=6
HASHI_CANCELLATION_COOLDOWN_MS=3600000
BITCOIN_DUST_FLOOR_SATS=546
# Generous: withdrawal is ~1.5–2 h end-to-end and is NEVER live-demoed (G6).
HASHI_WAIT_TIMEOUT_MS=9000000
EVENT_POLL_INTERVAL_MS=3000

# ── Guardian limiter genesis scalars (G5 trust anchors) ──────────────────────
# ⚠ U1: the LIVE testnet values are unpublished. These are the sample-config BOUND, not a fact.
REFILL_RATE_SATS_PER_S=1000
MAX_BUCKET_CAPACITY_SATS=100000000

# ── DeepBook (docs/RECON.md R4 + R5) ─────────────────────────────────────────
# moveCall targets the CURRENT CALLABLE package (v20)…
DEEPBOOK_PACKAGE_ID=0xd874d2417a55bfa6479bffa06ad950fea144ef93a94cc6c49f32b03e386bbb24
# …while TYPE ARGUMENTS resolve against the ORIGINAL / type-origin package (v1).
DEEPBOOK_ORIGINAL_PACKAGE_ID=0xfb28c4cbc6865bd1c897d26aecbe1f8792d1509a20ffec692c800660cbec6982
DEEPBOOK_POOL=0x5cdaebf264f8b0db4233098cb4cca33d11e4d8c179d5fbd36a5bed361a55ced6
DEEPBOOK_POOL_INITIAL_SHARED_VERSION=946570339
DBUSDC_COIN_TYPE=0xf7152c05930480cd740d7311b5b8b45c6f488e3a53a11c3f74a6fac36a52e0d7::DBUSDC::DBUSDC
DBUSDC_DECIMALS=6
DEEPBOOK_TICK_SIZE=1000000
DEEPBOOK_LOT_SIZE=1000
DEEPBOOK_MIN_SIZE=100000
# Required in real mode. The keeper holds ONLY the TradeCap (G2) — never a WithdrawCap.
BALANCE_MANAGER_ID=
TRADE_CAP_ID=

# ── Aphotic deployment (required in real mode) ───────────────────────────────
# ⚠ THESE NAMES ARE THE ONES `scripts/verify-onchain.mjs` READS. It resolves
#   process.env → keeper/.env → keeper/src/config.ts, so a name that differs by a
#   prefix is simply never found. This block used to ship `VAULT_ID` (no prefix)
#   and omit the other six entirely, which is why a fresh clone reported
#   `7 WARN … not published (or keeper/.env not wired)` while everything was in
#   fact deployed — the repo could not reproduce the `33 PASS · 0 WARN` that
#   docs/DEPLOYED.md records. Ids for the live deployment are in
#   docs/DEPLOYED.md § "APHOTIC v2 — PUBLISHED".
APHOTIC_PACKAGE_ID=
# The ORIGINAL id: type arguments resolve against it forever, while moveCall
# targets APHOTIC_PACKAGE_ID. They diverge on the first upgrade — keep both.
APHOTIC_ORIGINAL_PACKAGE_ID=
APHOTIC_VAULT_ID=
APHOTIC_BATCH_REGISTRY_ID=
APHOTIC_ADAPTER_REGISTRY_ID=
APHOTIC_ADMIN_CAP_ID=
APHOTIC_KEEPER_CAP_ID=
APHOTIC_UPGRADE_CAP_ID=
# ⚠ These two MUST DIFFER, or the two-party NAV split (G3) is void: one key would
#   both propose and approve. `verify-onchain.mjs` fails on `admin != keeper`, and
#   `scripts/rotate-keeper.mjs <addr> --execute` is the one-transaction fix.
APHOTIC_ADMIN_ADDRESS=
APHOTIC_KEEPER_ADDRESS=

# ── Pyth (docs/RECON.md R11) — PIN THESE (DAO auto-upgrade 2026-08-18, G9) ───
PYTH_STATE_ID=0x243759059f4c3111179da5878c12f68d612c21a8d54d85edc86164bb18be1c7c
PYTH_PACKAGE_ID=0xabf837e98c26087cba0883c0a7a28326b1fa3c5e1e2c5abdb486f9e8f594c837
WORMHOLE_STATE_ID=0x31358d198147da50db32eda2562951d53973a0c0ad5ed738e9b17d88b213d790
# ★ BETA-CHANNEL BTC/USD feed. NEVER the stable/mainnet id on testnet (G9).
PYTH_BTC_USD_FEED_ID=0xf9c0172ba10dfa4d19088d94f5bf61d3b54d5bd7483a322a982e1373ee8ea31b
HERMES_ENDPOINT=https://hermes-beta.pyth.network
PYTH_MAX_STALENESS_MS=60000
# Oracle-divergence breaker: Pyth vs DeepBook TWAP. Also the hBTC-depeg circuit breaker.
ORACLE_DIVERGENCE_BPS=200
TWAP_WINDOW_MS=300000

# ── Walrus (required in real mode) ───────────────────────────────────────────
WALRUS_PUBLISHER=
WALRUS_AGGREGATOR=
# ★ NEVER 1 — a 1-epoch blob expires almost immediately and the decision log stops being
#   verifiable. src/config.ts refuses any value below 2.
WALRUS_EPOCHS=12

# ── Seal ─────────────────────────────────────────────────────────────────────
# ⚠ WAS 2, WHICH CONTRADICTED THE APP AND THE SPEC. D9 is n = 5 across 5 distinct
#   operators, t = 3, and `app/.env.example` ships 3. Two halves of one system
#   disagreeing about a decryption threshold is the kind of drift G7 exists to stop.
SEAL_THRESHOLD=3
# Comma-separated key-server object ids. Required in real mode. Must match
# VITE_SEAL_KEY_SERVER_IDS in app/.env.example — one committee, not two.
# Browser-clean set, one server per operator (see app/.env.example for the
# measurement): Mysten Labs · Ruby Nodes · Overclock · Triton One · Natsai.
SEAL_KEY_SERVERS=0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75,0x6068c0acb197dddbacd4746a9de7f025b2ed5a5b6c1b1ab44dade4426d141da2,0x9c949e53c36ab7a9c484ed9e8b43267a77d4b8d70e79aa6b39042e3d4c434105,0x4cded1abeb52a22b6becb42a91d3686a4c901cf52eee16234214d0b5b2da4c46,0x3c93ec1474454e1b47cf485a4e5361a5878d722b9492daf10ef626a76adc3dad
# Bumped by vault::rotate — invalidates previously derived key shares.
SEAL_VERSION_EPOCH=0

# ── Keeper loop ──────────────────────────────────────────────────────────────
MAKER_TIMEOUT_MS=15000
# Decision-segment publish lag, so a live log cannot front-run resting maker orders.
LOG_PUBLISH_LAG_MS=60000
