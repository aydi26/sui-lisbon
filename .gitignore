# --- secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.key
*.keystore
sui.keystore

# --- node ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.eslintcache
npm-debug.log*
pnpm-debug.log*

# --- Move ---
move/build/
move/deps/**/build/

# --- OS / editor ---
Thumbs.db
.DS_Store
*.swp
.idea/

# --- local scratch ---
*.local
tmp/

# --- vercel (these two lines were appended by `vercel link`) ---
.vercel
.env*
# ...but .env.example is the canonical VITE_* list and MUST stay tracked.
!**/.env.example

# Scratch left behind by tooling. `*.tmp` is here because a shell-spliced source
# file lands as one, and a half-written .tsx that compiles is worse than one that
# does not — it gets committed.
*.tmp
*.bak
*.orig
*.rej
